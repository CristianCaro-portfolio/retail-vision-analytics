# Cloud ingest + analytics API.
FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[cloud]"

ENV PYTHONUNBUFFERED=1 RVA_DB_PATH=/data/events.duckdb
EXPOSE 8000
CMD ["uvicorn", "retail_vision.cloud.api:app", "--host", "0.0.0.0", "--port", "8000"]
