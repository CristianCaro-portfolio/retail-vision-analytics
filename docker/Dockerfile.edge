# Edge worker image: one container per camera (or per store with a process manager).
# Ships without PyTorch; real deployments mount an ONNX detector + ReID model.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir -e . onnxruntime

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["rva"]
CMD ["simulate", "--frames", "600", "--output", "/data/events.jsonl"]
